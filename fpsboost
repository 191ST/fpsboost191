-- Fungsi untuk boost FPS
local function boostFPS()
    if boosting then return end
    boosting = true
    
    button.Text = "BOOSTING..."
    button.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
    
    -- Settings untuk FPS Boost maksimal
    local settings = {
        -- Rendering settings
        RenderQuality = 1,
        RenderShadowQuality = 0,
        RenderLightingQuality = 0,
        RenderFidelity = 0,
        MeshPartDetail = 0,
        TextureQuality = 0,
        ImageQuality = 0,
        AntiAliasing = 0,
        ShadowQuality = 0,
        LightingQuality = 0,
        ReflectionQuality = 0,
        WaterQuality = 0,
        TextureQuality = 0,
        
        -- Visual settings
        ViewDistance = 1000,
        MaxParticles = 50,
        ParticleQuality = 0,
        RenderParticles = false,
        
        -- Advanced settings
        DisablePostEffects = true,
        DisableShadows = true,
        DisableReflections = true,
        DisableTransparency = true,
        DisableParticleLighting = true,
        
        -- FPS target
        TargetFPS = 60,
        Vsync = false,
        FrameRateCap = 999
    }
    
    -- Apply settings
    local success, err = pcall(function()
        -- Rendering settings
        settings().Rendering.QualityLevel = 1
        settings().Rendering.MeshPartDetail = Enum.MeshPartDetail.Level01
        settings().Rendering.TextureQuality = Enum.TextureQuality.Low
        settings().Rendering.ShadowQuality = Enum.ShadowQuality.Disabled
        settings().Rendering.LightingQuality = Enum.LightingQuality.Low
        settings().Rendering.ReflectionQuality = Enum.ReflectionQuality.Disabled
        
        -- Visual effects
        workspace.CurrentCamera.FieldOfView = 70
        workspace.CurrentCamera:GetPropertyChangedSignal("CFrame"):Connect(function() end)
        
        -- Disable unnecessary rendering
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CastShadow = false
                v.Material = Enum.Material.Plastic
                if v:IsA("MeshPart") then
                    v.TextureID = ""
                end
            elseif v:IsA("Decal") or v:IsA("Texture") then
                v.Transparency = 1
            elseif v:IsA("ParticleEmitter") then
                v.Enabled = false
            elseif v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                v.Enabled = false
            end
        end
        
        -- Optimize lighting
        local lighting = game:GetService("Lighting")
        lighting.GlobalShadows = false
        lighting.FogEnd = 1000
        lighting.Brightness = 1
        lighting.OutdoorAmbient = Color3.new(1, 1, 1)
        lighting.Ambient = Color3.new(0.5, 0.5, 0.5)
        
        -- Memory optimization
        collectgarbage("collect")
        collectgarbage("stop")
        
        -- Run loop untuk maintain FPS
        local runService = game:GetService("RunService")
        local lastTime = tick()
        local frameCount = 0
        local fps = 0
        
        spawn(function()
            while boosting do
                frameCount = frameCount + 1
                local currentTime = tick()
                if currentTime - lastTime >= 1 then
                    fps = frameCount
                    frameCount = 0
                    lastTime = currentTime
                    
                    -- Update button text dengan FPS realtime
                    if fps >= 60 then
                        button.Text = "60 FPS ✅"
                        button.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
                    elseif fps >= 50 then
                        button.Text = "50 FPS ⚡"
                        button.BackgroundColor3 = Color3.fromRGB(255, 255, 0)
                    elseif fps >= 40 then
                        button.Text = "40 FPS ⚡"
                        button.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                    elseif fps >= 30 then
                        button.Text = "30 FPS ⚡"
                        button.BackgroundColor3 = Color3.fromRGB(255, 150, 0)
                    else
                        button.Text = fps .. " FPS ⚡"
                    end
                end
                runService.RenderStepped:wait()
            end
        end)
        
        -- Game optimization
        game:GetService("Players").LocalPlayer.PlayerScripts:WaitForChild"PlayerModule":WaitForChild"CameraModule".ZoomDistance = 50
    end)
    
    if not success then
        warn("Boost error: " .. tostring(err))
        button.Text = "RETRY"
        button.BackgroundColor3 = Color3.fromRGB(255, 0, 0)
        boosting = false
    end
end

-- Fungsi reset boost
local function resetBoost()
    boosting = false
    button.Text = "FPS BOOST HIGH END"
    button.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    
    -- Reset settings
    pcall(function()
        settings().Rendering.QualityLevel = 3
        settings().Rendering.MeshPartDetail = Enum.MeshPartDetail.Level05
        settings().Rendering.TextureQuality = Enum.TextureQuality.High
        settings().Rendering.ShadowQuality = Enum.ShadowQuality.High
        
        local lighting = game:GetService("Lighting")
        lighting.GlobalShadows = true
        
        collectgarbage("restart")
    end)
end

-- Button click handler
button.MouseButton1Click:Connect(function()
    if button.Text == "FPS BOOST HIGH END" then
        boostFPS()
    else
        resetBoost()
    end
end)

-- Auto optimize saat GUI dimuat
local function initialOptimize()
    -- Set rendah dulu untuk loading
    settings().Rendering.QualityLevel = 2
    settings().Rendering.ShadowQuality = Enum.ShadowQuality.Disabled
    
    -- Tunggu game load
    game.Loaded:Wait()
    
    -- Siapkan untuk boost
    button.Text = "FPS BOOST HIGH END"
    button.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
end

spawn(initialOptimize)

